# =============================================================================
# GechExpress Backend — Environment Variables
# Copy this to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Django
DJANGO_SECRET_KEY=replace-with-a-50-char-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=gechexpress
POSTGRES_USER=gechexpress
POSTGRES_PASSWORD=gechexpress_dev_password
DATABASE_URL=postgresql://gechexpress:gechexpress_dev_password@db:5432/gechexpress

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Google OAuth (for customer login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_TEST-your-test-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1

# AWS S3 (for media in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Cloudinary (for media storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (Google SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=GechExpress <noreply@gechexpress.com>

# SMS Gateway (local Ethiopian provider)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Sentry (production only)
SENTRY_DSN=

# Frontend URL (for CORS and redirect URLs)
FRONTEND_URL=http://localhost:3000

# Platform Economics (overridden in DB via core_settings, but seeded from here)
BASE_COMMISSION_RATE=10.00
